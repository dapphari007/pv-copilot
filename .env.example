# Copy to .env and fill in. Only GROQ_API_KEY is required for AI analysis;
# without it the app runs in deterministic rule-based fallback mode.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional tuning ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MAX_CASES=0            # 0 = full FAERS dataset; set e.g. 5000 for a quick build
# TOP_K=5               # similar cases retrieved per query
# EMBEDDING_BATCH_SIZE=256
