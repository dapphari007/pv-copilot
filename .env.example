# Copy to .env and fill in. Only GROQ_API_KEY is required for AI analysis;
# without it the app runs in deterministic rule-based fallback mode.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional tuning ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MAX_CASES=0            # 0 = full FAERS dataset; set e.g. 5000 for a quick build
# TOP_K=5               # similar cases retrieved per query
# EMBEDDING_BATCH_SIZE=256

# --- Auth (redo branch) ---
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL=28800            # seconds (8h)
AUTH_REQUIRED=0                 # set 1 to enforce auth on API endpoints
ADMIN_EMAILS=                   # comma-separated emails auto-granted admin
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE=http://localhost:8000
# Google OAuth (https://console.cloud.google.com) — redirect: {BASE}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft OAuth (https://portal.azure.com) — redirect: {BASE}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
